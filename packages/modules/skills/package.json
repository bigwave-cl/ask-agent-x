{
  "name": "@askx/module-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/skills-module.d.ts",
      "import": "./dist/skills-module.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    },
    "./skill-types": {
      "types": "./dist/skill-types.d.ts",
      "import": "./dist/skill-types.js"
    },
    "./canonical-source-manager": {
      "types": "./dist/canonical-source-manager.d.ts",
      "import": "./dist/canonical-source-manager.js"
    }
  },
  "scripts": {
    "build": "tsup src/skills-module.ts src/scanner.ts src/skill-types.ts src/canonical-source-manager.ts --format esm --dts --clean",
    "dev": "tsup src/skills-module.ts src/scanner.ts src/skill-types.ts src/canonical-source-manager.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@askx/core": "workspace:*",
    "@askx/platform-adapters": "workspace:*",
    "zod": "^3.24.1"
  }
}
