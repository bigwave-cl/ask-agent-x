    "@askx/module-skills": "workspace:*",
    "@askx/platform-adapters": "workspace:*",
    "@askx/web": "workspace:*",
    "commander": "^13.0.0",
    "ink": "^7.1.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  }
}
