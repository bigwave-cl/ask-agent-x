{
  "name": "askagent-x",
  "version": "0.1.0",
  "description": "Extend every agent. Keep control.",
  "type": "module",
  "bin": {
    "askx": "./dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean",
    "dev": "tsup src/index.tsx --format esm --dts --watch",
