{
  "name": "@askx/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "scripts": {
    "build": "nuxt build && tsup src/server.ts --format esm --dts --out-dir dist/server --clean",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "dev": "NUXT_ASKX_SESSION_TOKEN=askx-local-dev nuxt dev --host 127.0.0.1 --port 4242"
  },
  "dependencies": {
    "@askx/core": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.25.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.8",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue-tsc": "^3.2.5"
  }
}
