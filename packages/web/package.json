{
  "name": "@askx/web",
  "version": "26.805.2",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "scripts": {
    "build": "nuxt build && node scripts/copy-builtin-skills.mjs && node scripts/verify-highlight-chunks.mjs && tsup src/server.ts --format esm --dts --out-dir dist/server --clean",
    "typecheck": "nuxt prepare && nuxt typecheck && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests --exclude=perf/**",
    "test:performance": "playwright test --config perf/playwright.config.ts",
    "preview:performance": "NUXT_ASKX_SESSION_TOKEN=askx-local-dev HOST=127.0.0.1 PORT=4252 node .output/server/index.mjs",
    "dev": "NUXT_ASKX_SESSION_TOKEN=askx-local-dev nuxt dev --host 127.0.0.1 --port 4242"
  },
  "dependencies": {
    "@askx/core": "workspace:*",
    "@askx/module-skills": "workspace:*",
    "@iconify/utils": "^3.1.4",
    "@lucide/vue": "^1.25.0",
    "@nuxt/icon": "^2.3.1",
    "@tailwindcss/typography": "^0.5.16",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "marked": "^17.0.6",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.5.1",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.8.0",
    "shadcn-vue": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.2.5"
  }
}
